Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Jacobi", "[", 
     RowBox[{"A0_", ",", "B0_", ",", "P0_", ",", "max_"}], "]"}], ":=", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A", "=", 
         RowBox[{"N", "[", "A0", "]"}]}], ",", " ", 
        RowBox[{"B", "=", 
         RowBox[{"N", "[", "B0", "]"}]}], ",", "i", ",", "j", ",", 
        RowBox[{"k", "=", "0"}], ",", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "P0", "]"}]}], ",", 
        RowBox[{"P", "=", "P0"}], ",", 
        RowBox[{"Pold", "=", "P0"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<p\>\"", ",", "0"}], "]"}], ",", "\"\<=\>\"", ",", 
         "P"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"k", "<", "max"}], ",", 
         RowBox[{
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "1"}], ",", 
            RowBox[{"i", "\[LessEqual]", "n"}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"P", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "=", " ", 
             RowBox[{
              RowBox[{"1", "/", 
               RowBox[{"A", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", " ", "i"}], "]"}], "]"}]}], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"B", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], " ", "+", " ", 
                RowBox[{
                 RowBox[{"A", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", " ", "i"}], "]"}], "]"}], 
                 RowBox[{"P", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], " ", "-", " ", 
                RowBox[{
                 UnderoverscriptBox["\[Sum]", 
                  RowBox[{"j", "=", "1"}], "n"], 
                 RowBox[{
                  RowBox[{"A", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
                  RowBox[{"P", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}]}]}], ")"}]}]}]}], "]"}], 
          ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<p\>\"", ",", 
              RowBox[{"k", "+", "1"}]}], "]"}], ",", "\"\<=\>\"", ",", "P"}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"k", "=", 
           RowBox[{"k", "+", "1"}]}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "P", "]"}], ";"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"(", 
    RowBox[{"{", 
     RowBox[{
